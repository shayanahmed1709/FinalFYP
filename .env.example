# Copy to .env or .env.local and fill in on the host (Vercel, Railway, or your shell).
# Credentials belong only in server environment variables.
# Never commit real values, never hardcode them, and never prefix secrets with NEXT_PUBLIC_.

# SQLite path is resolved relative to the prisma directory.
DATABASE_URL="file:./dev.db"

# SMTP account used to send mail. For Gmail this is the mailbox and an app password.
EMAIL_USER=your-mailbox@example.com
EMAIL_PASSWORD=your-smtp-or-app-password

# Optional. Defaults to smtp.gmail.com:587 when unset.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Used by prisma/seed.js and the demo-user scripts. If unset, those scripts
# generate a random admin password and print it once.
DEMO_ADMIN_PASSWORD=replace-with-a-strong-password

# Secret for signing login tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Public site URL (safe to expose). Do not put passwords or tokens here.
NEXT_PUBLIC_APP_URL=http://localhost:3000
